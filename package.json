{
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tailwindcss": "^3.4.19"
  },
  "name": "nifty-reader",
  "version": "1.0.0",
  "description": "Desktop reader application for https://search.niftyarchives.org/ Built with Dioxus (Rust)",
  "main": "tailwind.config.js",
  "scripts": {
    "build-css": "tailwindcss -i ./input.css -o ./assets/main.css",
    "watch-css": "tailwindcss -i ./input.css -o ./assets/main.css --watch",
    "watch-rust": "cargo watch -i \"downloads/*\" -x run",
    "dev": "concurrently \"npm run watch-css\" \"npm run watch-rust\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeHungryBoi/nifty-reader.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/LeHungryBoi/nifty-reader/issues"
  },
  "homepage": "https://github.com/LeHungryBoi/nifty-reader#readme"
}
