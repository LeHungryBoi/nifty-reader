import { Button, TextEdit, ListView, ScrollView, VerticalBox, HorizontalBox, LineEdit, ListItem, Rectangle } from "std-widgets.slint";

export struct StorySummary {
    title: string,
    url: string,
    snippet: string,
    categories: [string],
    subcategories: [string],
    date_added: string,
    chapters: [{title: string, url: string}],
}

export struct Story {
    title: string,
    url: string,
    paragraphs: [string],
    categories: [string],
    subcategories: [string],
}

export struct HistoryItem {
    title: string,
    url: string,
    timestamp: u64,
}

export struct AppSettings {
    theme: string,
    font_size: float,
    proxy_url: string,
}

export struct AppState {
    settings: AppSettings,
    history: [HistoryItem],
}

export component AppWindow inherits Window {
    in-out property <string> theme: "light";
    in-out property <float> font_size: 1.0;
    in-out property <string> proxy_url: "";
    in-out property <bool> loading: false;
    in-out property <string> error: "";
    in-out property <bool> show_settings: false;
    in-out property <bool> show_history: false;
    in-out property <int> current_page: 1;
    in-out property <string> search_query: "";
    in-out property <string> selected_category: "All";
    in-out property <string> selected_subcategory: "All";
    in-out property <bool> speaking: false;
    in-out property <string> current_story_title: "";
    in-out property <string> current_story_text: "";

    in property <[StorySummary]> browse_list: [];
    in property <[HistoryItem]> history: [];

    callback on_refresh();
    callback on_open_settings();
    callback on_open_history();
    callback on_close_settings();
    callback on_close_history();
    callback on_read_url(string);
    callback on_change_page(int);
    callback on_change_category(string);
    callback on_change_subcategory(string);
    callback on_search(string);
    callback on_clear_history();
    callback on_toggle_theme();
    callback on_font_decrease();
    callback on_font_increase();
    callback on_tts_toggle();

    title: "NiftyReader";
    width: 1000px;
    height: 800px;
    min_width: 800px;
    min_height: 600px;

    background: theme == "dark" ? #1a1a1a : #ffffff;

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Header
        Rectangle {
            height: 50px;
            background: theme == "dark" ? #2a2a2a : #f0f0f0;

            HorizontalBox {
                padding: 8px;
                spacing: 8px;

                // Logo/Title
                Text {
                    text: "NiftyReader";
                    font-size: 18px;
                    font-weight: bold;
                    horizontal-stretch: 1;
                }

                // Font controls (only show when story is loaded)
                if current_story_title != "": HorizontalBox {
                    spacing: 4px;
                    Button { text: "A-"; clicked => { root.on_font_decrease(); } }
                    Button { text: "A+"; clicked => { root.on_font_increase(); } }
                }

                // Navigation buttons
                Button { text: "Refresh"; clicked => { root.on_refresh(); } }
                Button { text: "History"; clicked => { root.on_open_history(); } }
                Button { text: theme == "dark" ? "Light" : "Dark"; clicked => { root.on_toggle_theme(); } }
                Button { text: "Settings"; clicked => { root.on_open_settings(); } }
            }
        }

        // Main content area
        if loading: ScrollView {
            VerticalBox {
                Text { text: "Loading..."; horizontal-alignment: center; }
            }
        } else if error != "": ScrollView {
            VerticalBox {
                Text { text: error; color: red; }
            }
        } else if show_history: ScrollView {
            VerticalBox {
                if history.length == 0: VerticalBox {
                    Text { text: "No reading history yet."; horizontal-alignment: center; }
                    Button { text: "Start Browsing"; clicked => { root.on_close_history(); } }
                } else: ListView {
                    for item in history: ListItem {
                        text: item.title;
                        clicked => { root.on_read_url(item.url); }
                    }
                }

                if history.length > 0: Button { text: "Clear History"; clicked => { root.on_clear_history(); } }
                Button { text: "Back"; clicked => { root.on_close_history(); } }
            }
        } else if current_story_title != "": ScrollView {
            VerticalBox {
                // Reader view
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "< Back"; clicked => { root.on_close_history(); } }
                    Button { text: speaking ? "Stop" : "Read Aloud"; clicked => { root.on_tts_toggle(); } }
                }

                Text {
                    text: current_story_title;
                    font-size: 24px;
                    font-weight: bold;
                }

                Text {
                    text: current_story_text;
                    font-size: root.font_size * 16px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                Button {
                    text: "Back to Library";
                    clicked => { root.on_close_history(); }
                }
            }
        } else: ScrollView {
            // Browse view
            VerticalBox {
                // Search bar
                HorizontalBox {
                    spacing: 8px;
                    LineEdit {
                        placeholder: "Search keywords...";
                        text: search_query;
                        accepted => { root.on_search(self.text); }
                    }
                    Button { text: "Search"; clicked => { root.on_search(search_query); } }
                }

                // Categories
                HorizontalBox {
                    for cat in ["All", "Gay Male", "Bisexual", "Lesbian", "Transgender", "Bestiality"]: Button {
                        text: cat;
                        clicked => { root.on_change_category(cat); }
                    }
                }

                // Subcategories
                if selected_category != "All": HorizontalBox {
                    for sub in ["All", "adult-friends", "adult-youth", "athletics", "college", "highschool", "military", "romance"]: Button {
                        text: sub;
                        clicked => { root.on_change_subcategory(sub); }
                    }
                }

                // Story list
                if browse_list.length == 0: Text { text: "Loading stories..."; }
                else: ListView {
                    for story in browse_list: ListItem {
                        text: story.title;
                        clicked => { root.on_read_url(story.url); }
                    }
                }

                // Pagination
                HorizontalBox {
                    Button {
                        text: "Prev";
                        enabled: root.current_page > 1;
                        clicked => { root.on_change_page(root.current_page - 1); }
                    }
                    Text { text: "Page " + root.current_page; }
                    Button { text: "Next"; clicked => { root.on_change_page(root.current_page + 1); } }
                }
            }
        }

        // Settings modal overlay
        if show_settings: Rectangle {
            background: #00000080;

            Rectangle {
                width: 400px;
                height: 180px;
                background: theme == "dark" ? #2a2a2a : #ffffff;
                border-radius: 8px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                VerticalBox {
                    padding: 20px;
                    spacing: 12px;

                    Text { text: "Settings"; font-size: 20px; font-weight: bold; }

                    Text { text: "Proxy URL:"; }
                    LineEdit {
                        placeholder: "http://127.0.0.1:7890";
                        text: proxy_url;
                    }

                    HorizontalBox {
                        spacing: 8px;
                        Button { text: "Save"; clicked => { root.on_close_settings(); } }
                        Button { text: "Cancel"; clicked => { root.on_close_settings(); } }
                    }
                }
            }
        }
    }
}